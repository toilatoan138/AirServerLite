<Window x:Class="AirServerLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirServer-LITE" Height="880" Width="680"
        Background="{StaticResource Bg}"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBorder" Grid.Row="0" Background="{StaticResource Panel}" Padding="10,8"
                BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="Start receiver" Click="OnStartStop" Width="105"/>
                <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="4,2,8,2"/>
                <Button x:Name="BtnHome" Content="Home" Click="OnHome"/>
                <Button x:Name="BtnVolUp" Content="Vol +" Click="OnVolumeUp"/>
                <Button x:Name="BtnVolDown" Content="Vol -" Click="OnVolumeDown"/>
                <Button x:Name="BtnLock" Content="Lock" Click="OnLock"/>
                <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="4,2,8,2"/>
                <CheckBox x:Name="ChkInput" Content="Mouse control"
                          Foreground="{StaticResource Text}" VerticalAlignment="Center"
                          Click="OnInputToggled"/>
                <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="8,2,8,2"/>
                <TextBlock Text="🔊" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider x:Name="SliderVolume" Width="70" Minimum="0" Maximum="1" Value="1"
                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
                <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="8,2,8,2"/>
                <Button x:Name="BtnFullscreen" Content="⛶ Fullscreen" Click="OnFullscreenClicked"/>
                <Button x:Name="BtnQuickPlay" Content="▶ YouTube" Click="OnQuickPlayClicked" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Video surface -->
        <Border x:Name="VideoHost" Grid.Row="1" Background="#FF0B0C0F" ClipToBounds="True"
                Focusable="True"
                MouseLeftButtonDown="OnVideoMouseDown"
                MouseLeftButtonUp="OnVideoMouseUp"
                MouseRightButtonDown="OnVideoRightDown"
                MouseWheel="OnVideoWheel"
                MouseMove="OnVideoMouseMove"
                SizeChanged="OnVideoHostSizeChanged">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="LowQuality"
                       SnapsToDevicePixels="True"/>

                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="40">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="120" Height="120"
                           HorizontalAlignment="Center" Margin="0,0,0,18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AirServer-LITE" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="No stream" FontSize="14" HorizontalAlignment="Center"
                               Margin="0,4,0,0" Foreground="{StaticResource TextDim}"/>
                    <TextBlock x:Name="PlaceholderHint" Margin="0,12,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"
                               Foreground="{StaticResource TextDim}"
                               Text="Start the receiver, then pick this device in Control Centre &#8594; Screen Mirroring."/>
                </StackPanel>

                <!-- Cinema Overlay HUD (Fullscreen controls) -->
                <Border x:Name="OverlayHud" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="#DD161820" CornerRadius="8" Padding="14,8" Margin="0,0,0,28"
                        BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnHudExitFs" Content="Thoát Fullscreen (Esc/F11)" Click="OnExitFullscreen" Margin="0,0,10,0"/>
                        <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="0,2,10,2"/>
                        <TextBlock Text="🔊" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="SliderHudVolume" Width="90" Minimum="0" Maximum="1" Value="1"
                                VerticalAlignment="Center" ValueChanged="OnHudVolumeChanged"/>
                        <Rectangle Width="1" Fill="{StaticResource PanelEdge}" Margin="10,2,10,2"/>
                        <Button Content="Home" Click="OnHome" Margin="0,0,6,0"/>
                        <Button Content="Vol -" Click="OnVolumeDown" Margin="0,0,4,0"/>
                        <Button Content="Vol +" Click="OnVolumeUp"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="{StaticResource Panel}" Padding="10,6"
                BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Bad}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Stopped"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatsText" Grid.Column="2" Text=""
                           Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Log -->
        <Expander x:Name="LogExpander" Grid.Row="3" Header="Log" Foreground="{StaticResource TextDim}"
                  Background="{StaticResource Panel}" Padding="6" IsExpanded="False">
            <ListBox x:Name="LogList" Height="170" Background="#FF14161B"
                     BorderThickness="0" Foreground="{StaticResource TextDim}"
                     FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Expander>
    </Grid>
</Window>
